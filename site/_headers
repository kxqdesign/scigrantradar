# Browsers must check for a newer version on every visit. Unchanged files
# are answered with a tiny "not modified" reply, so this costs little, and
# visitors never run an old script against a new page after an update.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Static brand fonts and media benefit from long caching while HTML and JSON stay fresh.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/feed.xml
  Content-Type: application/atom+xml; charset=utf-8
  Cache-Control: public, max-age=3600

/calendar.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=3600
